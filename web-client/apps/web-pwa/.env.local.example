# Copy this file to .env.local (already gitignored, see .gitignore)
# ONLY if you need it -- see below. Most phone/LAN testing does NOT
# need this file anymore.
#
# adapters/web/src/WebAdapter.ts's resolveWebSocketUrl() now defaults
# to the SAME HOST the page itself was loaded from (not a hardcoded
# "localhost"), on the default game-server port (53010). That means
# opening http://<your-PC-LAN-IP>:5173 on a phone already gets you
# ws://<your-PC-LAN-IP>:53010 automatically, with no configuration --
# covers the common case (Vite dev server and the Python game server
# running on the SAME machine).
#
# You only need VITE_WS_URL if:
# - the game server is on a DIFFERENT machine than the one serving
#   this page, or
# - you started the server with a non-default --ws-port.
#
# VITE_WS_URL=ws://<game-server-host>:<ws-port>
