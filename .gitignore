# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# PyInstaller build output — regenerated by KADI.spec, never source
build/
dist/

# Virtual environments, if anyone uses one locally
venv/
.venv/
env/

# Per-user runtime data — this project deliberately keeps this OUT of
# the project folder entirely (see core/game_logger.py's base_dir()),
# so none of this should ever actually appear here. Ignored anyway as
# a safety net, in case an old/legacy-path install ever leaves
# something behind in the source tree. Does NOT include msomi_models/
# — that folder is a static, curated shipped resource (currently just
# the one reference model), never a runtime write target; nothing ever
# gets generated into the project's own copy of it.
logs/
profile.json
settings.json

# OS-generated cruft
.DS_Store
Thumbs.db

# Editor/IDE
.vscode/
.idea/
*.swp
